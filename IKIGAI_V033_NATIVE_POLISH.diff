+  background: linear-gradient(180deg, color-mix(in srgb, var(--onboarding-surface-strong) 94%, transparent), color-mix(in srgb, var(--onboarding-surface) 90%, transparent));
+  color: var(--ik-text);
+  cursor: pointer;
+}
+.ik-milestone-trigger svg { flex: 0 0 auto; color: var(--ik-faint); transition: transform var(--ik-motion-fast) var(--ik-ease-standard); }
+.ik-milestone-picker:has(.ik-milestone-menu) .ik-milestone-trigger svg { transform: rotate(180deg); }
+.ik-milestone-trigger:hover,
+.ik-milestone-trigger:focus-visible { border-color: color-mix(in srgb, var(--ik-accent) 52%, var(--ik-border)); }
+.ik-milestone-menu {
+  position: absolute;
+  z-index: 90;
+  top: calc(100% + 7px);
+  left: 0;
+  width: 100%;
+  min-width: 145px;
+  padding: 6px;
+  display: grid;
+  gap: 2px;
+  border: 1px solid var(--ik-border);
+  border-radius: 14px;
+  background: var(--onboarding-surface-strong);
+  box-shadow: 0 20px 55px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.08);
+  animation: first-light-popover-in 140ms var(--ik-ease-standard);
+}
+.important-date-row .ik-milestone-menu button {
+  width: 100%;
+  min-height: 35px;
+  height: auto;
+  padding: 0 9px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  border: 0;
+  border-radius: 9px;
+  background: transparent;
+  color: var(--ik-muted);
+  font: 580 10px/1 var(--ik-body);
+  text-align: left;
+}
+.important-date-row .ik-milestone-menu button:hover,
+.important-date-row .ik-milestone-menu button.selected { color: var(--ik-text); background: color-mix(in srgb, var(--ik-accent) 10%, transparent); }
+.important-date-row .ik-milestone-menu button.selected svg { color: var(--ik-accent-text); }
+
+/* Familiar setup gets a real resident preview. */
+.onboarding-familiar-stage { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(250px, .65fr); gap: 18px; align-items: stretch; }
+.onboarding-familiar-config { min-width: 0; }
+.onboarding-familiar-preview {
+  min-height: 100%;
+  position: relative;
+  overflow: hidden;
+  padding: 18px;
+  display: grid;
+  grid-template-rows: auto minmax(220px, 1fr) auto;
+  gap: 12px;
+  border: 1px solid color-mix(in srgb, var(--ik-accent) 17%, var(--ik-border));
+  border-radius: 22px;
+  background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--ik-accent) 11%, transparent), transparent 34%), linear-gradient(160deg, color-mix(in srgb, var(--onboarding-surface-strong) 96%, transparent), color-mix(in srgb, var(--onboarding-surface) 86%, transparent));
+  box-shadow: 0 22px 60px color-mix(in srgb, var(--ik-shadow) 45%, transparent), inset 0 1px 0 rgba(255,255,255,.08);
+}
+.onboarding-preview-label { color: var(--ik-accent-text); font: 800 8px/1 var(--ik-mono); letter-spacing: .17em; }
+.familiar-preview-room { position: relative; min-height: 220px; display: grid; place-items: center; }
+.familiar-preview-floor { position: absolute; left: 12%; right: 12%; bottom: 24px; height: 54px; border-radius: 50%; background: radial-gradient(ellipse, color-mix(in srgb, var(--ik-accent) 13%, transparent), transparent 70%); }
+.familiar-preview-moon { position: absolute; width: 86px; height: 86px; right: 10%; top: 8%; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--ik-accent) 16%, transparent); background: color-mix(in srgb, var(--ik-accent) 4%, transparent); }
+.familiar-preview-nook { position: relative; z-index: 2; min-width: 160px; min-height: 150px; display: grid; place-items: center; transition: transform 220ms var(--ik-ease-standard), opacity 220ms ease; }
+.onboarding-familiar-preview.side-left .familiar-preview-nook { transform: translateX(-22px); }
+.onboarding-familiar-preview.side-right .familiar-preview-nook { transform: translateX(22px); }
+.onboarding-familiar-preview.is-home-only .familiar-preview-room { opacity: .62; }
+.onboarding-familiar-preview.is-home-only .familiar-preview-nook { filter: saturate(.72); }
+.familiar-preview-copy { display: grid; gap: 4px; text-align: center; }
+.familiar-preview-copy strong { font: 650 22px/1 var(--ik-display); }
+.familiar-preview-copy span { color: var(--ik-muted); font-size: 10px; }
+.familiar-preview-copy small { color: var(--ik-faint); font-size: 9px; line-height: 1.45; }
+
+/* Paper & Time uses the real Daily paper renderer and the same Journey preview grammar as Settings. */
+.onboarding-paper-live-layout { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(330px, .82fr); gap: 18px; align-items: stretch; }
+.onboarding-paper-live-layout .onboarding-paper-calendar-layout { grid-template-columns: minmax(220px, .78fr) minmax(320px, 1.22fr); gap: 14px; }
+.onboarding-time-preview {
+  min-width: 0;
+  padding: 16px;
+  display: grid;
+  align-content: start;
+  gap: 12px;
+  border: 1px solid color-mix(in srgb, var(--ik-accent) 16%, var(--ik-border));
+  border-radius: 22px;
+  background: linear-gradient(160deg, color-mix(in srgb, var(--onboarding-surface-strong) 96%, transparent), color-mix(in srgb, var(--onboarding-surface) 88%, transparent));
+  box-shadow: 0 22px 60px color-mix(in srgb, var(--ik-shadow) 42%, transparent), inset 0 1px 0 rgba(255,255,255,.08);
+}
+.onboarding-time-preview-grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: 12px; align-items: stretch; }
+.onboarding-daily-preview { min-height: 250px; padding: 14px; display: grid; place-items: center; align-content: center; gap: 18px; border: 1px solid var(--ik-border); border-radius: 17px; background: color-mix(in srgb, var(--ik-bg) 18%, var(--onboarding-surface)); }
+.onboarding-daily-preview .paper-edition-preview { width: 98px; }
+.onboarding-daily-preview > div { display: grid; gap: 3px; text-align: center; }
+.onboarding-daily-preview > div strong { font-size: 11px; }
+.onboarding-daily-preview > div small { color: var(--ik-muted); font: 700 8px/1 var(--ik-mono); text-transform: uppercase; letter-spacing: .08em; }
+.onboarding-journey-live { margin: 0; min-height: 250px; padding: 0; border-radius: 17px; overflow: hidden; }
+.onboarding-journey-live .journey-calendar-demo-stage { min-height: 205px; padding: 12px; }
+.onboarding-journey-live .journey-calendar-demo-board { width: min(100%, 250px); transform: scale(.84); }
+.onboarding-journey-live > footer { padding: 10px 12px; }
+.onboarding-journey-live > footer p { display: none; }
+.onboarding-time-preview-note { color: var(--ik-faint); font-size: 9px; line-height: 1.45; }
+
+@media (max-width: 1120px) {
+  .onboarding-familiar-stage,
+  .onboarding-paper-live-layout { grid-template-columns: 1fr; }
+  .onboarding-familiar-preview { min-height: 300px; grid-template-rows: auto 1fr auto; }
+}
+@media (max-width: 900px) {
+  .ik-date-calendar { right: auto; left: 0; }
+  .onboarding-paper-live-layout .onboarding-paper-calendar-layout { grid-template-columns: 1fr; }
+  .onboarding-time-preview-grid { grid-template-columns: 1fr 1fr; }
+}
+@media (max-width: 620px) {
+  .ik-date-calendar { width: min(290px, calc(100vw - 42px)); }
+  .onboarding-time-preview-grid { grid-template-columns: 1fr; }
+}
