{
  "name": "ikigai-os",
  "private": true,
  "version": "0.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cleanup:retired": "node scripts/cleanup-retired.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integrity": "node --experimental-strip-types --test tests/integrityCore.test.ts",
    "audit:static": "node scripts/audit-static.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:companion-browser": "node scripts/audit-companion-browser.mjs",
    "verify": "npm run cleanup:retired && npm run audit:release && npm run audit:static && npm run audit:ui && npm run audit:icons && npm test && npm run build && npm run audit:dist && npm run audit:branding",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:icons": "node scripts/audit-lucide.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "tauri": "tauri",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "audit:workspace-browser": "node scripts/audit-workspace-browser.mjs",
    "audit:reset-browser": "node scripts/audit-reset-browser.mjs",
    "audit:onboarding-skip-browser": "node scripts/audit-onboarding-skip-browser.mjs",
    "audit:branding-browser": "node scripts/audit-branding-browser.mjs",
    "audit:branding": "node scripts/audit-branding.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "dexie": "4.4.6",
    "framer-motion": "13.4.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
